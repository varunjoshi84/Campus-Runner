# Server Configuration
PORT=3000

# PostgreSQL Connection String (Supabase Connection Pooler)
# IPv4-friendly shared transaction-mode pooler (port 6543)
DATABASE_URL=postgresql://postgres.jwbkpayvgsyqxliumbqb:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres

# Shared session-mode pooler (port 5432)
DIRECT_URL=postgresql://postgres.jwbkpayvgsyqxliumbqb:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# JWT Secret Key for Session Tokens
JWT_SECRET=campus_runner_super_secret_jwt_key_change_me_in_prod

# Google OAuth Web Client ID & Secret
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_web_client_secret

# Development bypass login (/auth/dev) - useful for emulator/testing without real Google Sign-In
DEV_LOGIN=true
