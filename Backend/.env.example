# Server Configuration
PORT=3000

# PostgreSQL Connection String
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campus_runner

# JWT Secret Key for Session Tokens
JWT_SECRET=campus_runner_super_secret_jwt_key_change_me_in_prod

# Google OAuth Web Client ID (Used by backend to verify tokens from Android app)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Development bypass login (/auth/dev) - useful for emulator/testing without real Google Sign-In
DEV_LOGIN=true
